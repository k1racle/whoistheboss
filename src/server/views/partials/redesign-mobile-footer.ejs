<%
  const footerLocals = typeof locals !== 'undefined' && locals ? locals : {};
  const footerSocial = footerLocals.social || {};
  const footerPageLinks = Array.isArray(footerLocals.pageLinks) && footerLocals.pageLinks.length ? footerLocals.pageLinks : [
    { href: '/companies', label: 'КОМПАНИИ', mobileLabel: 'МЕСТА' },
    { href: '/entrepreneurs', label: 'БИОГРАФИЯ', mobileLabel: 'БИОГРАФИЯ' },
    { href: '/interviews', label: 'ИНТЕРВЬЮ', mobileLabel: 'ИНТЕРВЬЮ' },
    { href: '/blog', label: 'СТАТЬИ', mobileLabel: 'СТАТЬИ' },
    { href: '/blog', label: 'БЛОГ', mobileLabel: 'БЛОГ' },
  ];
  const footerCtaHref = typeof footerLocals.ctaHref === 'string' && footerLocals.ctaHref.trim()
    ? footerLocals.ctaHref.trim()
    : '/shooting-request';
%>
<div class="redesign-footer__mobile">
  <div class="redesign-footer__mobile-top">
    <div class="redesign-footer__mobile-links redesign-footer__mobile-links--pages">
      <% footerPageLinks.forEach((item) => { %>
        <a href="<%= item.href %>"><%= item.mobileLabel || item.label %></a>
      <% }) %>
    </div>
    <div class="redesign-footer__mobile-links redesign-footer__mobile-links--social">
      <%- include('social-text-links', { social: footerSocial }) %>
    </div>
  </div>

  <div class="redesign-footer__mobile-bottom">
    <div class="redesign-footer__mobile-cta-row">
      <span>ГОТОВЫ</span>
      <span>К</span>
      <span>ОБСУЖДЕНИЮ</span>
      <span>ПРОЕКТА</span>
      <span>?</span>
    </div>

    <a class="footer-hero-button redesign-footer__mobile-button" href="<%= footerCtaHref %>">
      СТАТЬ ГЕРОЕМ <span class="arrow-mark" aria-hidden="true"></span>
    </a>

    <div class="redesign-footer__mobile-meta">
      <div class="redesign-footer__mobile-meta-column">
        <span>ПОЛИТИКА</span>
        <span>КОНФ-ТИ</span>
      </div>
      <div class="redesign-footer__mobile-meta-column redesign-footer__mobile-meta-column--center">
        <span>ПОШТА</span>
        <span>НАША</span>
      </div>
      <div class="redesign-footer__mobile-meta-column redesign-footer__mobile-meta-column--right">
        <span>ИП</span>
        <span>БАТАГОВ</span>
      </div>
    </div>
  </div>
</div>
