<%- include('../partials/header', { title, description, siteName, siteDescription, transparentHeader: true, hideSiteHeader: true }) %>
<%
  const settings = typeof homeSettings !== 'undefined' ? homeSettings : {};
  const projectLinks = typeof social !== 'undefined' ? social : {};
  const bannerImage = settings.HOME_BANNER_IMAGE || '';
  const bannerMobileImage = settings.HOME_BANNER_MOBILE_IMAGE || '';
  const bannerLink = settings.HOME_BANNER_LINK || '/blog';
  const hasBannerImage = Boolean(bannerImage || bannerMobileImage);
  const publishedDate = article.publishedAt || article.createdAt;
  const selectedMaterials = typeof relatedMaterials !== 'undefined' ? relatedMaterials : [];
  const nextArticles = typeof latestArticles !== 'undefined' ? latestArticles : [];
  const defaultSectionOrder = ['cover', 'content', 'secondary', 'related', 'latest', 'banner'];
  let sectionVisibility = {};
  let sectionOrder = defaultSectionOrder;
  try {
    const parsedVisibility = JSON.parse(article.sectionVisibility || '{}');
    if (parsedVisibility && typeof parsedVisibility === 'object' && !Array.isArray(parsedVisibility)) sectionVisibility = parsedVisibility;
  } catch {}
  try {
    const parsedOrder = JSON.parse(article.sectionOrder || '[]');
    if (Array.isArray(parsedOrder)) {
      const valid = parsedOrder.filter((key, index) => defaultSectionOrder.includes(key) && parsedOrder.indexOf(key) === index);
      sectionOrder = [...valid, ...defaultSectionOrder.filter((key) => !valid.includes(key))];
    }
  } catch {}
  const showSection = (key) => Object.prototype.hasOwnProperty.call(sectionVisibility, key)
    ? sectionVisibility[key] !== false
    : true;
%>

<div class="redesign-page blog-detail-page">
  <header class="home-header">
    <nav class="home-topbar">
      <div class="home-topbar__left">
        <a href="/" class="home-topbar__project-logo is-visible" aria-label="Кто здесь главный?">
          <img src="/images/image-29.svg" alt="Кто здесь главный?">
        </a>
        <a href="/entrepreneurs" class="home-topbar__link">ПРЕДПРИНИМАТЕЛИ</a>
        <a href="/companies" class="home-topbar__link">КОМПАНИИ</a>
        <a href="/blog" class="home-topbar__link">БЛОГ</a>
      </div>
      <div class="home-topbar__right">
        <a href="/shooting-request" class="home-topbar__shooting">СЪЕМКИ</a>
        <a href="/shooting-request" class="home-topbar__cta">СТАТЬ ГЕРОЕМ <span class="arrow-mark" aria-hidden="true"></span></a>
      </div>
    </nav>
  </header>

  <% if (showSection('cover')) { %>
    <section class="blog-detail-section blog-detail-section--cover">
      <div class="blog-detail__container">
        <header class="blog-detail__header">
          <h1><%= article.title %></h1>
          <div class="blog-detail__meta">
            <time datetime="<%= publishedDate.toISOString() %>">Дата: <%= formatDate(publishedDate) %></time>
            <% if (article.entrepreneur) { %><span>Автор: <%= article.entrepreneur.name %></span><% } %>
            <% if (article.category) { %><span class="blog-detail__category"><%= article.category %></span><% } %>
          </div>
        </header>

        <% if (article.coverImage) { %>
          <figure class="blog-detail__cover">
            <img src="<%= article.coverImage %>" alt="<%= article.title %>">
          </figure>
        <% } %>
      </div>
    </section>
  <% } %>

  <% if (showSection('content')) { %>
    <section class="blog-detail-section blog-detail-section--content">
      <div class="blog-detail__container">
        <div class="blog-detail__body article-content"><%- article.content %></div>
      </div>
    </section>
  <% } %>

  <% if (showSection('secondary') && (article.secondaryImage || article.secondaryText)) { %>
    <section class="blog-detail-section blog-detail-section--secondary">
      <div class="blog-detail__container">
        <div class="blog-detail__split">
          <div class="blog-detail__split-media">
            <% if (article.secondaryImage) { %><img src="<%= article.secondaryImage %>" alt=""><% } %>
          </div>
          <div class="blog-detail__split-copy article-content"><%- article.secondaryText || '' %></div>
        </div>
      </div>
    </section>
  <% } %>

  <% if (showSection('related') && selectedMaterials.length) { %>
    <section class="blog-detail-section blog-detail-section--related blog-detail-related">
      <div class="blog-detail__container">
        <h2><%= article.relatedTitle || 'МАТЕРИАЛЫ ПО ТЕМЕ' %></h2>
        <div class="blog-detail-related__grid">
          <% selectedMaterials.forEach(({ type, item }, index) => { %>
            <% if (type === 'entrepreneur') { %>
              <a class="hero-card<%= item.hoverPhoto ? ' hero-card--has-hover-image' : '' %>" href="/entrepreneurs/<%= item.slug %>" style="--delay: <%= index * 90 %>ms; --offset: <%= (index % 3 - 1) * 5 %>%">
                <span class="hero-card-name"><%= item.name %></span>
                <span class="hero-card-arrow" aria-hidden="true"></span>
                <img src="<%= item.photo || '/images/placeholder.svg' %>" alt="<%= item.name %>" loading="lazy">
                <% if (item.hoverPhoto) { %>
                  <img class="hero-card-hover" src="<%= item.hoverPhoto %>" alt="" loading="lazy">
                <% } %>
                <span class="hero-card-meta"><%= item.title || '' %></span>
              </a>
            <% } else { %>
              <a class="company-card" href="/companies/<%= item.slug %>">
                <div class="company-card__media">
                  <h3 class="company-card__title"><%= item.name %></h3>
                  <% if (item.coverImage) { %><img src="<%= item.coverImage %>" alt="<%= item.name %>" loading="lazy"><% } %>
                </div>
                <div class="company-card__footer">
                  <span class="company-card__arrow" aria-hidden="true"><img src="/images/company-card-arrow.svg" alt=""></span>
                  <p><%= item.type || '' %></p>
                </div>
              </a>
            <% } %>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>

  <% if (showSection('latest') && nextArticles.length) { %>
    <section class="blog-detail-section blog-detail-section--latest blog-detail-latest">
      <div class="blog-detail__container">
        <h2>ЧИТАТЬ ДАЛЬШЕ</h2>
        <div class="blog-latest__list">
          <% nextArticles.forEach((item) => { %>
            <a class="blog-latest-card" href="/blog/<%= item.slug %>">
              <strong class="blog-latest-card__subject blog-latest-card__heading"><%= item.entrepreneur?.name || 'КТО ЗДЕСЬ ГЛАВНЫЙ?' %></strong>
              <span class="blog-latest-card__copy">
                <strong class="blog-latest-card__heading"><%= item.title %></strong>
                <% if (item.subtitle) { %><span><%= item.subtitle %></span><% } %>
              </span>
              <span class="blog-latest-card__media" aria-hidden="true">
                <% if (item.coverImage) { %><img src="<%= item.coverImage %>" alt="" loading="lazy"><% } %>
              </span>
              <span class="blog-latest-card__arrow" aria-hidden="true"><span class="arrow-mark"></span></span>
            </a>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>

  <% if (showSection('banner')) { %>
    <section class="blog-detail-section blog-detail-section--banner site-banner redesign-section<%= hasBannerImage ? ' site-banner--has-image' : '' %>">
      <a href="<%= bannerLink %>" class="site-banner-frame" aria-label="Открыть материал баннера">
        <% if (hasBannerImage) { %>
          <picture class="site-banner-media">
            <% if (bannerMobileImage) { %>
              <source media="(max-width: 768px)" srcset="<%= bannerMobileImage %>">
            <% } %>
            <img src="<%= bannerImage || bannerMobileImage %>" alt="" class="banner-image">
          </picture>
        <% } %>
      </a>
    </section>
  <% } %>

  <footer class="redesign-footer" id="contacts">
    <div class="footer-top">
      <div class="footer-links footer-links--pages">
        <a href="/companies">КОМПАНИИ</a>
        <a href="/entrepreneurs">БИОГРАФИИ</a>
        <a href="/interviews">ИНТЕРВЬЮ</a>
        <a href="/blog">СТАТЬИ</a>
        <a href="/blog">БЛОГ</a>
      </div>
      <div class="footer-links footer-links--social">
        <%- include('../partials/social-text-links', { social: projectLinks }) %>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="footer-bottom-left">
        <div class="footer-cta-row"><span>ГОТОВЫ</span><span>К</span><span>ОБСУЖДЕНИЮ</span><span>ПРОЕКТА</span><span>?</span></div>
        <a href="/shooting-request" class="footer-hero-button">СТАТЬ ГЕРОЕМ <span class="arrow-mark" aria-hidden="true"></span></a>
      </div>
      <div class="footer-meta"><span>ИП</span><span>БАТАГОВ А.А.</span><span>TILDA EXPERTS</span><span>ПОЛИТИКА КОНФ-ТИ</span></div>
    </div>
  </footer>
</div>

<script src="/js/main.js"></script>
<script>
  (() => {
    const page = document.querySelector('.blog-detail-page');
    if (!page) return;
    const selectors = {
      cover: '.blog-detail-section--cover',
      content: '.blog-detail-section--content',
      secondary: '.blog-detail-section--secondary',
      related: '.blog-detail-section--related',
      latest: '.blog-detail-section--latest',
      banner: '.blog-detail-section--banner'
    };
    const order = <%- JSON.stringify(sectionOrder) %>;
    const footer = page.querySelector('.redesign-footer');
    order.forEach((key) => {
      const section = page.querySelector(selectors[key]);
      if (section && footer) page.insertBefore(section, footer);
    });
  })();
</script>
</body>
</html>
