<%- include('partials/header', { title, description, siteName, siteUrl, transparentHeader: true, hideSiteHeader: true }) %>

<% const home = typeof homeSettings !== 'undefined' ? homeSettings : {}; %>
<% const aboutText = home.HOME_ABOUT_TEXT || 'Мы рассказываем личные истории предпринимателей через их дело. За каждым рестораном, магазином, студией, производством или компанией стоит человек со своим путем, идеями, победами и трудностями. Именно эти истории мы показываем честно и без прикрас.\n\nНаши интервью, биографии, статьи и репортажи помогают увидеть не только успешный бизнес, но и людей, которые стоят за ним. Потому что главное - не вывеска, а человек, который ее создал.'; %>
<% const aboutBottomText = home.HOME_ABOUT_BOTTOM_TEXT || 'Мы убеждены, что каждый успешный бизнес начинается с человека. Поэтому рассказываем не только о компаниях и проектах, но прежде всего о людях, которые их создали.'; %>
<% const aboutType = home.HOME_ABOUT_VIDEO_TYPE || (home.HOME_ABOUT_VIDEO_FILE ? 'SELF_HOSTED' : 'EMBED'); %>
<% const aboutVideo = home.HOME_ABOUT_VIDEO_FILE || home.HOME_ABOUT_VIDEO_URL || ''; %>
<% const aboutHoverType = home.HOME_ABOUT_HOVER_VIDEO_TYPE || (home.HOME_ABOUT_HOVER_VIDEO_FILE ? 'SELF_HOSTED' : 'EMBED'); %>
<% const aboutHoverVideo = home.HOME_ABOUT_HOVER_VIDEO_FILE || home.HOME_ABOUT_HOVER_VIDEO_URL || ''; %>
<% const bannerImage = home.HOME_BANNER_IMAGE || ''; %>
<% const bannerMobileImage = home.HOME_BANNER_MOBILE_IMAGE || ''; %>
<% const bannerLink = home.HOME_BANNER_LINK || '/entrepreneurs'; %>
<% const hasBannerImage = Boolean(bannerImage || bannerMobileImage); %>
<%
  const homeSectionDefaults = ['hero', 'about', 'audience', 'heroes', 'places', 'stages', 'latestNews', 'cta', 'banner'];
  let homeSectionVisibility = {};
  let homeSectionOrder = homeSectionDefaults;
  try {
    const parsedVisibility = JSON.parse(home.HOME_SECTION_VISIBILITY || '{}');
    if (parsedVisibility && typeof parsedVisibility === 'object' && !Array.isArray(parsedVisibility)) homeSectionVisibility = parsedVisibility;
  } catch {}
  try {
    const parsedOrder = JSON.parse(home.HOME_SECTION_ORDER || '[]');
    if (Array.isArray(parsedOrder)) {
      const valid = parsedOrder.filter((key, index) => homeSectionDefaults.includes(key) && parsedOrder.indexOf(key) === index);
      homeSectionOrder = [...valid, ...homeSectionDefaults.filter((key) => !valid.includes(key))];
    }
  } catch {}
  const homeSectionClass = (key) => homeSectionVisibility[key] === false ? ' is-section-hidden' : '';
  const homeHeroLines = (home.HOME_HERO_TITLE || 'КТО ЗДЕСЬ\nГЛАВНЫЙ?').split(/\r?\n/).filter(Boolean);
  const homeHeroFirst = homeHeroLines[0] || 'КТО ЗДЕСЬ';
  const homeHeroSecond = homeHeroLines.slice(1).join(' ') || 'ГЛАВНЫЙ?';
  const homeAboutTitle = home.HOME_ABOUT_TITLE || 'О ПРОЕКТЕ';
  const homeAudienceTitle = home.HOME_AUDIENCE_TITLE || 'ДЛЯ КОГО';
  const homeHeroesTitle = home.HOME_HEROES_TITLE || 'НАШИ ГЕРОИ';
  const homeHeroesText = home.HOME_HEROES_TEXT || 'Главные герои проекта — предприниматели, которые своим трудом, идеями и решениями создают бизнес и меняют окружающий мир.';
  const homePlacesTitle = home.HOME_PLACES_TITLE || 'МЕСТА';
  const homePlacesText = home.HOME_PLACES_TEXT || 'Компании и проекты наших героев: места, бренды и команды, за которыми стоят реальные предпринимательские истории.';
  const homeStagesTitle = home.HOME_STAGES_TITLE || 'ЭТАПЫ';
  const homeLatestNewsTitle = home.HOME_LATEST_NEWS_TITLE || 'ПОСЛЕДНИЕ НОВОСТИ';
  const homeLatestNewsDescription = home.HOME_LATEST_NEWS_DESCRIPTION || 'Новости проекта, истории предпринимателей и материалы о компаниях.';
  const homeCtaTitle = home.HOME_CTA_TITLE || 'СТАНЬ УЧАСТНИКОМ ПРОЕКТА';
  const homeCtaFormTitle = home.HOME_CTA_FORM_TITLE || 'ЗАПОЛНИТЕ ВАШИ ДАННЫЕ ДЛЯ СВЯЗИ';
  const homeCtaFormDescription = home.HOME_CTA_FORM_DESCRIPTION || 'Отправьте нам заявку и мы перезвоним.';
%>
<% const links = typeof social !== 'undefined' ? social : {}; %>
<% const audienceItems = typeof audienceCards !== 'undefined' ? audienceCards : []; %>
<% const allHeroes = typeof entrepreneurs !== 'undefined' ? entrepreneurs : []; %>
<% const featuredHeroes = allHeroes.length <= 3 ? allHeroes : allHeroes.slice(2, 6); %>
<% const placeItems = typeof businesses !== 'undefined' ? businesses : []; %>
<% const latestArticles = typeof articles !== 'undefined' ? articles : []; %>
<% const mobileFeatureHero = allHeroes[0] || null; %>
<% const mobileHeroCards = allHeroes.length ? allHeroes.slice(0, 6) : featuredHeroes; %>
<% const mobilePlaceCards = placeItems.slice(0, 6); %>
<% const mobileNewsItems = latestArticles.slice(0, 5); %>
<% const forWhoCards = audienceItems.length ? audienceItems : [
  { title: 'Предприниматели', hoverTitle: 'Герои бизнеса' },
  { title: 'Руководители', hoverTitle: 'Лидеры команд' },
  { title: 'Основатели компаний', hoverTitle: 'Создатели идей' },
  { title: 'Владельцы собственного бизнеса', hoverTitle: 'Те, кто строит свое' },
  { title: 'Управляющие партнеры', hoverTitle: 'Лица решений' },
  { title: 'Генеральные директора', hoverTitle: 'Те, кто ведет вперед' },
  { title: 'Создатели чего-то', hoverTitle: 'Авторы нового' }
]; %>
<% let stageCards = [
  { index: '01', title: 'Подготовка', subtitle: 'и сбор материалов', eyebrow: '[ как начинается проект ]', description: 'На первом этапе мы знакомимся с героем проекта, изучаем историю его бизнеса, собираем архивные фотографии, видеоматериалы, документы и другую информацию, которая поможет раскрыть его путь.' },
  { index: '02', title: 'Съемочный', subtitle: 'процесс', eyebrow: '[ фундамент проекта ]', description: 'Проводим съемку подкаста и большого интервью, где предприниматель рассказывает свою историю. Затем выезжаем на предприятие, в офис, ресторан, производство или другое место, чтобы показать бизнес изнутри, команду, рабочие процессы и атмосферу.' },
  { index: '03', title: 'Создание', subtitle: 'материалов', eyebrow: '[ визуализация ]', description: 'После съемок команда монтирует видео, обрабатывает фотографии, пишет биографию героя, готовит статьи, интервью и дополнительные материалы для публикации.' },
  { index: '04', title: 'Публикация', subtitle: 'и продвижение', eyebrow: '[ реализация проекта ]', description: 'Готовый контент размещается на сайте проекта и распространяется по всем каналам коммуникации: в социальных сетях, на видеоплатформах, в подкаст-сервисах, СМИ и на других информационных площадках.' },
]; %>
<% try {
  const savedStages = JSON.parse(home.HOME_STAGES_JSON || '[]');
  if (Array.isArray(savedStages) && savedStages.length) stageCards = savedStages;
} catch {} %>

<div class="redesign-page">
  <div class="home-mobile">
    <section class="mobile-home__hero">
      <div class="mobile-home__hero-top">
        <a href="/" class="mobile-home__logo" aria-label="Кто здесь главный?">
          <img src="/images/image-29.svg" alt="Кто здесь главный?">
        </a>
        <div class="mobile-home__hero-side">
          <a href="/shooting-request" class="mobile-home__hero-cta">СТАТЬ ГЕРОЕМ <span class="arrow-mark" aria-hidden="true"></span></a>
          <nav class="mobile-home__nav" aria-label="Навигация по разделам">
            <a href="/entrepreneurs">предприниматели</a>
            <a href="/companies">компании</a>
            <a href="/blog">блог</a>
            <a href="/shooting-request">съемка</a>
          </nav>
          <div class="mobile-home__hero-lines" aria-hidden="true">
            <span></span>
            <span></span>
          </div>
        </div>
      </div>
      <div class="mobile-home__hero-copy">
        <h1><span><%= homeHeroFirst %></span><span><%= homeHeroSecond %></span></h1>
      </div>
    </section>

    <section class="mobile-home__about">
      <div class="mobile-home__about-media">
        <% if (aboutVideo && aboutType === 'EMBED') { %>
          <iframe src="<%= aboutVideo %>" title="О проекте" loading="lazy" allow="autoplay; fullscreen" allowfullscreen></iframe>
        <% } else if (aboutVideo) { %>
          <video src="<%= aboutVideo %>" controls preload="metadata" muted playsinline></video>
        <% } else { %>
          <span class="video-placeholder">Видео появится после загрузки в админке</span>
        <% } %>
        <span class="video-play" aria-hidden="true"></span>
      </div>
      <h2><%= homeAboutTitle %></h2>
      <div class="mobile-home__copy"><%- aboutText.replace(/\n\n/g, '<br><br>') %></div>
      <a class="mobile-home__button" href="/shooting-request">СТАТЬ ГЕРОЕМ <span class="arrow-mark" aria-hidden="true"></span></a>
      <p class="mobile-home__about-bottom"><%= aboutBottomText %></p>
    </section>

    <% if (mobileFeatureHero) { %>
      <section class="mobile-home__feature">
        <a class="mobile-home__feature-card" href="/entrepreneurs/<%= mobileFeatureHero.slug %>">
          <span class="mobile-home__feature-label">НОВЫЙ ГЕРОЙ УЖЕ НА САЙТЕ</span>
          <span class="mobile-home__feature-name"><%= mobileFeatureHero.name %></span>
          <img src="<%= mobileFeatureHero.photo || '/images/placeholder.svg' %>" alt="<%= mobileFeatureHero.name %>" loading="lazy">
          <span class="mobile-home__feature-role"><%= mobileFeatureHero.title || '' %></span>
          <span class="mobile-home__feature-arrow" aria-hidden="true"><span class="arrow-mark"></span></span>
        </a>
      </section>
    <% } %>

    <section class="mobile-home__section mobile-home__section--heroes">
      <div class="mobile-home__section-head">
        <h2><%= homeHeroesTitle %></h2>
        <p><%= homeHeroesText %></p>
        <a class="mobile-home__button mobile-home__button--ghost" href="/entrepreneurs">ЕЩЕ <span class="arrow-mark" aria-hidden="true"></span></a>
      </div>
      <div class="mobile-home__cards-row">
        <% mobileHeroCards.forEach((item, index) => { %>
          <a class="hero-card mobile-home__hero-card<%= item.hoverPhoto ? ' hero-card--has-hover-image' : '' %>" href="/entrepreneurs/<%= item.slug %>" style="--delay: <%= index * 90 %>ms; --offset: <%= (index % 3 - 1) * 5 %>%">
            <span class="hero-card-name"><%= item.name %></span>
            <span class="hero-card-arrow" aria-hidden="true"></span>
            <img src="<%= item.photo || '/images/placeholder.svg' %>" alt="<%= item.name %>" loading="lazy">
            <% if (item.hoverPhoto) { %>
              <img class="hero-card-hover" src="<%= item.hoverPhoto %>" alt="" loading="lazy">
            <% } %>
            <span class="hero-card-meta"><%= item.title || '' %></span>
          </a>
        <% }) %>
      </div>
    </section>

    <section class="mobile-home__section mobile-home__section--places">
      <div class="mobile-home__section-head">
        <h2><%= homePlacesTitle %></h2>
        <p><%= homePlacesText %></p>
        <a class="mobile-home__button mobile-home__button--ghost" href="/companies">ЕЩЕ <span class="arrow-mark" aria-hidden="true"></span></a>
      </div>
      <div class="mobile-home__cards-row">
        <% mobilePlaceCards.forEach((item) => { %>
          <a class="company-card mobile-home__place-card" href="/companies/<%= item.slug %>">
            <div class="company-card__media">
              <h3 class="company-card__title"><%= item.name %></h3>
              <% if (item.coverImage) { %>
                <img src="<%= item.coverImage %>" alt="<%= item.name %>" loading="lazy">
              <% } %>
            </div>
            <div class="company-card__footer">
              <span class="company-card__arrow" aria-hidden="true">
                <img src="/images/company-card-arrow.svg" alt="">
              </span>
              <p><%= item.type %></p>
            </div>
          </a>
        <% }) %>
      </div>
    </section>

    <section class="mobile-home__news">
      <div class="mobile-home__section-head">
        <h2><%= homeLatestNewsTitle %></h2>
      </div>
      <div class="mobile-home__news-list">
        <% mobileNewsItems.forEach((item) => { %>
          <a class="mobile-home__news-card" href="/blog/<%= item.slug %>">
            <strong><%= item.entrepreneur?.name || 'КТО ЗДЕСЬ ГЛАВНЫЙ?' %></strong>
            <span><%= item.title %></span>
            <% if (item.subtitle) { %><p><%= item.subtitle %></p><% } %>
            <span class="mobile-home__news-arrow" aria-hidden="true"><span class="arrow-mark"></span></span>
          </a>
        <% }) %>
      </div>
    </section>

    <section class="mobile-home__audience">
      <p class="mobile-home__audience-copy"><%= aboutBottomText %></p>
      <h2><span>ДЛЯ</span><span>КОГО</span></h2>
    </section>

    <section class="mobile-home__form-section" id="shooting-mobile">
      <div class="mobile-home__form-section-inner">
        <h2><%= homeCtaFormTitle %></h2>
        <form action="/api/shooting-request" method="POST" class="mobile-home__form">
          <input type="hidden" name="redirect" value="/#shooting-mobile">
          <label>
            <span>Ваше имя*</span>
            <input type="text" name="name" autocomplete="name" required>
          </label>
          <label>
            <span>Номер телефона*</span>
            <input type="tel" name="phone" autocomplete="tel" required>
          </label>
          <button type="submit">ОТПРАВИТЬ</button>
        </form>
      </div>
    </section>
  </div>

  <div class="home-desktop">
  <section class="redesign-hero<%= homeSectionClass('hero') %>" id="top">
    <header class="home-header">
      <nav class="home-topbar">
        <div class="home-topbar__left">
          <a href="/" class="home-topbar__project-logo" data-header-project-logo aria-label="Кто здесь главный?"><img src="/images/image-29.svg" alt="Кто здесь главный?"></a>
          <a href="/entrepreneurs" class="home-topbar__link">ПРЕДПРИНИМАТЕЛИ</a>
          <a href="/companies" class="home-topbar__link">КОМПАНИИ</a>
        <a href="/blog" class="home-topbar__link">БЛОГ</a>
        </div>
        <div class="home-topbar__right">
          <a href="#shooting" class="home-topbar__shooting">СЪЕМКИ</a>
          <a href="/shooting-request" class="home-topbar__cta">СТАТЬ ГЕРОЕМ <span class="arrow-mark" aria-hidden="true"></span></a>
        </div>
      </nav>
    </header>
    <div class="hero-copy">
      <h1><%= homeHeroFirst %><br><em><%= homeHeroSecond %></em></h1>
    </div>
  </section>

  <section class="about-project redesign-section<%= homeSectionClass('about') %>" id="about">
    <a href="/" class="section-corner-logo" aria-label="Кто здесь главный?">
      <img src="/images/image-29.svg" alt="Кто здесь главный?">
    </a>
    <div class="about-project__inner">
      <div class="about-copy">
        <h2><%= homeAboutTitle %></h2>
        <p><%- aboutText.replace(/\n\n/g, '<br><br>') %></p>
        <a class="red-button" href="/shooting-request">СТАТЬ ГЕРОЕМ <span class="arrow-mark" aria-hidden="true"></span></a>
      </div>
      <div
        class="about-video"
        data-about-video
        data-default-type="<%= aboutType %>"
        data-default-src="<%= aboutVideo %>"
        data-hover-type="<%= aboutHoverType %>"
        data-hover-src="<%= aboutHoverVideo %>"
      >
        <% if (aboutVideo && aboutType === 'EMBED') { %>
          <iframe src="<%= aboutVideo %>" title="О проекте" loading="lazy" allow="autoplay; fullscreen" allowfullscreen></iframe>
        <% } else if (aboutVideo) { %>
          <video src="<%= aboutVideo %>" controls preload="metadata" muted playsinline></video>
        <% } else { %>
          <span class="video-placeholder">Видео появится после загрузки в админке</span>
        <% } %>
      <span class="video-play" aria-hidden="true"></span>
      </div>
    </div>
    <p class="about-project__bottom"><%= aboutBottomText %></p>
  </section>

  <section class="for-who redesign-section<%= homeSectionClass('audience') %>" id="for-whom">
    <div class="for-who-pin" data-for-who-pin>
      <div class="for-who-scene" data-for-who-scene>
        <div class="for-who-title-wrap">
          <h2 class="giant-center-title for-who-title-default"><%= homeAudienceTitle %></h2>
          <div class="for-who-final" aria-hidden="true">
            <h2 class="giant-center-title">ЭТО ПРО МЕНЯ</h2>
            <a href="/shooting-request" class="entrepreneur-biography__button for-who-final__button">СТАТЬ УЧАСТНИКОМ</a>
          </div>
        </div>
        <div class="for-who-stage">
          <% forWhoCards.forEach((card, index) => { %>
            <article class="audience-card audience-card--<%= (index % 7) + 1 %> audience-card--slot-<%= (index % 7) + 1 %>" data-audience-card>
              <span class="card-arrow" aria-hidden="true"></span>
              <div class="audience-card__face audience-card__face--default">
                <strong><%= card.title %></strong>
                <% if (card.description) { %>
                  <small><%= card.description %></small>
                <% } %>
              </div>
              <div class="audience-card__face audience-card__face--hover">
                <strong><%= card.hoverTitle || card.title %></strong>
                <% if (card.hoverDescription || card.description) { %>
                  <small><%= card.hoverDescription || card.description %></small>
                <% } %>
              </div>
            </article>
          <% }) %>
        </div>
      </div>
    </div>
  </section>

  <section class="heroes redesign-section<%= homeSectionClass('heroes') %>" id="heroes">
    <div class="section-heading">
      <div class="section-heading__top">
        <h2><%= homeHeroesTitle %></h2>
        <a class="red-button section-heading__more" href="/entrepreneurs">
          ЕЩЕ <span class="arrow-mark" aria-hidden="true"></span>
        </a>
      </div>
      <p><%= homeHeroesText %></p>
    </div>
    <div class="heroes-list">
      <% featuredHeroes.forEach((item, index) => { %>
        <a class="hero-card reveal-card<%= item.hoverPhoto ? ' hero-card--has-hover-image' : '' %>" href="/entrepreneurs/<%= item.slug %>" style="--delay: <%= index * 90 %>ms; --offset: <%= (index % 3 - 1) * 5 %>%">
          <span class="hero-card-name"><%= item.name %></span>
          <span class="hero-card-arrow" aria-hidden="true"></span>
          <img src="<%= item.photo || '/images/placeholder.svg' %>" alt="<%= item.name %>">
          <% if (item.hoverPhoto) { %>
            <img class="hero-card-hover" src="<%= item.hoverPhoto %>" alt="">
          <% } %>
          <span class="hero-card-meta"><%= item.title %></span>
        </a>
      <% }) %>
    </div>
  </section>

  <section class="home-places redesign-section<%= homeSectionClass('places') %>" id="places">
    <div class="section-heading">
      <div class="section-heading__top">
        <h2><%= homePlacesTitle %></h2>
        <a class="red-button section-heading__more" href="/companies">
          ЕЩЕ <span class="arrow-mark" aria-hidden="true"></span>
        </a>
      </div>
      <p><%= homePlacesText %></p>
    </div>
    <div class="companies-grid">
      <% placeItems.forEach((item) => { %>
        <a class="company-card" href="/companies/<%= item.slug %>">
          <div class="company-card__media">
            <h3 class="company-card__title"><%= item.name %></h3>
            <% if (item.coverImage) { %>
              <img src="<%= item.coverImage %>" alt="<%= item.name %>" loading="lazy">
            <% } %>
          </div>
          <div class="company-card__footer">
            <span class="company-card__arrow" aria-hidden="true">
              <img src="/images/company-card-arrow.svg" alt="">
            </span>
            <p><%= item.type %></p>
          </div>
        </a>
      <% }) %>
    </div>
  </section>

  <section class="stages redesign-section<%= homeSectionClass('stages') %>" id="stages">
    <div class="stages-pin" data-stages-pin>
      <div class="stages-scene" data-stages-scene>
        <div class="stages-head">
          <h2 class="giant-center-title"><%= homeStagesTitle %></h2>
        </div>
        <div class="stages-viewport">
          <div class="stages-track" data-stages-track>
            <% stageCards.forEach((stage, index) => { %>
              <article class="stage-card stage-card--summary" data-stage-card style="--stage-order: <%= index * 2 %>">
                <span class="card-index">[ <%= stage.index %> ]</span>
                <strong><%= stage.title %></strong>
                <small><%= stage.subtitle %></small>
              </article>
              <article class="stage-card stage-card--detail" data-stage-card style="--stage-order: <%= index * 2 + 1 %>">
                <span class="stage-eyebrow"><%= stage.eyebrow %></span>
                <p><%= stage.description %></p>
              </article>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="blog-latest home-latest-news<%= homeSectionClass('latestNews') %>" id="latest-news">
    <div class="companies-container">
      <div class="blog-latest__header">
        <h2><%= homeLatestNewsTitle %></h2>
        <p><%= homeLatestNewsDescription %></p>
      </div>
      <div class="blog-latest__list">
        <% latestArticles.forEach((item) => { %>
          <a class="blog-latest-card" href="/blog/<%= item.slug %>">
            <strong class="blog-latest-card__subject blog-latest-card__heading"><%= item.entrepreneur?.name || 'КТО ЗДЕСЬ ГЛАВНЫЙ?' %></strong>
            <span class="blog-latest-card__copy">
              <strong class="blog-latest-card__heading"><%= item.title %></strong>
              <% if (item.subtitle) { %>
                <span><%= item.subtitle %></span>
              <% } %>
            </span>
            <span class="blog-latest-card__media">
              <% if (item.coverImage) { %>
                <img src="<%= item.coverImage %>" alt="" loading="lazy">
              <% } %>
            </span>
            <span class="blog-latest-card__arrow" aria-hidden="true"><span class="arrow-mark"></span></span>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <%- include('partials/shooting-cta', {
    sectionClass: homeSectionClass('cta'),
    redirect: '/#shooting',
    formTitle: homeCtaFormTitle,
    redHeaderTheme: false
  }) %>

  <section class="site-banner redesign-section<%= hasBannerImage ? ' site-banner--has-image' : '' %><%= homeSectionClass('banner') %>">
    <a href="<%= bannerLink %>" class="site-banner-frame" aria-label="Открыть материал баннера">
      <% if (hasBannerImage) { %>
        <picture class="site-banner-media">
          <% if (bannerMobileImage) { %>
            <source media="(max-width: 768px)" srcset="<%= bannerMobileImage %>">
          <% } %>
          <img src="<%= bannerImage || bannerMobileImage %>" alt="" class="banner-image">
        </picture>
      <% } else { %>
        <div class="banner-title">ЗДЕСЬ БУДЕТ<br>БАННЕР ДЛЯ<br>ВЫПУСКА С<br>НОВЫМ ГЕРОЕМ</div>
      <% } %>
    </a>
  </section>
  </div>
</div>
</main>

