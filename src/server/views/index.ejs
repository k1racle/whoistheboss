<script src="/js/main.js" defer></script>
<script>
  (() => {
    const page = document.querySelector('.home-desktop');
    if (!page) return;
    const selectors = {
      hero: '.redesign-hero',
      about: '.about-project',
      audience: '.for-who',
      heroes: '.heroes',
      places: '.home-places',
      stages: '.stages',
      latestNews: '.home-latest-news',
      cta: '.shooting-cta',
      banner: '.site-banner'
    };
    const order = <%- JSON.stringify(homeSectionOrder) %>;
    order.forEach((key) => {
      const section = page.querySelector(selectors[key]);
      if (section) page.appendChild(section);
    });
  })();

  document.querySelectorAll('.reveal-card').forEach((card) => {
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.disconnect();
      }
    }, { threshold: 0.12 });
    observer.observe(card);
  });

  const randomizeLatestCardImage = (card) => {
    if (window.matchMedia('(max-width: 900px)').matches) return;
    const media = card.querySelector('.blog-latest-card__media:not(:empty)');
    if (!media) return;

    const cardWidth = card.getBoundingClientRect().width;
    const mediaWidth = media.getBoundingClientRect().width || 180;
    const zoneStart = cardWidth * 0.6;
    const zoneEnd = cardWidth * 0.9;
    const maxLeft = Math.max(zoneStart, zoneEnd - mediaWidth);
    const left = zoneStart + Math.random() * (maxLeft - zoneStart);
    const top = -30 + Math.random() * 40;
    let rotation = -10 + Math.random() * 20;
    if (Math.abs(rotation) < 2) rotation = rotation < 0 ? -2 : 2;

    card.style.setProperty('--hover-image-left', `${left}px`);
    card.style.setProperty('--hover-image-top', `${top}px`);
    card.style.setProperty('--hover-image-rotation', `${rotation.toFixed(2)}deg`);
  };

  document.querySelectorAll('.home-latest-news .blog-latest-card').forEach((card) => {
    card.addEventListener('mouseenter', () => randomizeLatestCardImage(card));
    card.addEventListener('focus', () => randomizeLatestCardImage(card));
  });

  const isDesktopHomeViewport = () => window.matchMedia('(min-width: 769px)').matches;

  const aboutVideoBlock = document.querySelector('[data-about-video]');
  if (aboutVideoBlock) {
    const defaultType = aboutVideoBlock.getAttribute('data-default-type') || '';
    const defaultSrc = aboutVideoBlock.getAttribute('data-default-src') || '';
    const hoverType = aboutVideoBlock.getAttribute('data-hover-type') || '';
    const hoverSrc = aboutVideoBlock.getAttribute('data-hover-src') || '';
    const videoEl = aboutVideoBlock.querySelector('video');
    const iframeEl = aboutVideoBlock.querySelector('iframe');

    const swapAboutMedia = (type, src) => {
      if (!src) return;
      if (videoEl && type === 'SELF_HOSTED') {
        if (videoEl.getAttribute('src') !== src) {
          videoEl.setAttribute('src', src);
          videoEl.load();
        }
        return;
      }
      if (iframeEl && type === 'EMBED' && iframeEl.getAttribute('src') !== src) {
        iframeEl.setAttribute('src', src);
      }
    };

    if (hoverSrc) {
      aboutVideoBlock.addEventListener('mouseenter', () => swapAboutMedia(hoverType, hoverSrc));
      aboutVideoBlock.addEventListener('mouseleave', () => swapAboutMedia(defaultType, defaultSrc));
    }
  }

  const siteBannerButton = document.querySelector('.site-banner .red-button');
  if (siteBannerButton) {
    siteBannerButton.innerHTML = 'СМОТРЕТЬ ЭКСКЛЮЗИВНО НА НАШЕМ САЙТЕ <span class="arrow-mark" aria-hidden="true"></span>';
  }

  const homeHeader = isDesktopHomeViewport() ? document.querySelector('.home-header') : null;
  const redThemeSections = Array.from(document.querySelectorAll('.shooting-cta'));
  if (homeHeader && redThemeSections.length) {
    let isOnRed = false;
    const updateHeaderTheme = () => {
      const probeY = homeHeader.getBoundingClientRect().bottom + 8;
      const overlapThreshold = 32;
      const activeRedSection = redThemeSections.some((section) => {
        const rect = section.getBoundingClientRect();
        return rect.top <= probeY - overlapThreshold && rect.bottom >= probeY + overlapThreshold;
      });

      if (activeRedSection !== isOnRed) {
        isOnRed = activeRedSection;
        homeHeader.classList.toggle('is-on-red', isOnRed);
      }
    };

    updateHeaderTheme();
    window.addEventListener('scroll', updateHeaderTheme, { passive: true });
    window.addEventListener('resize', updateHeaderTheme);
  }

  const headerProjectLogo = isDesktopHomeViewport() ? document.querySelector('[data-header-project-logo]') : null;
  const sectionProjectLogo = isDesktopHomeViewport() ? document.querySelector('.section-corner-logo') : null;
  const headerLeftSlot = isDesktopHomeViewport() ? document.querySelector('.home-topbar__left') : null;
  if (headerProjectLogo && sectionProjectLogo && headerLeftSlot) {
    let isDocked = false;

    const updateProjectLogoDock = () => {
      const sectionLogoRect = sectionProjectLogo.getBoundingClientRect();
      const slotRect = headerLeftSlot.getBoundingClientRect();
      const shouldDock = sectionLogoRect.top <= slotRect.top + 6;

      if (shouldDock !== isDocked) {
        isDocked = shouldDock;
        headerProjectLogo.classList.toggle('is-docked', isDocked);
        sectionProjectLogo.classList.toggle('is-docked-away', isDocked);
      }
    };

    updateProjectLogoDock();
    window.addEventListener('scroll', updateProjectLogoDock, { passive: true });
    window.addEventListener('resize', updateProjectLogoDock);
  }

  const stageSection = isDesktopHomeViewport() ? document.querySelector('#stages') : null;
  const stagesPin = isDesktopHomeViewport() ? document.querySelector('.stages-pin') : null;
  const stagesScene = isDesktopHomeViewport() ? document.querySelector('[data-stages-scene]') : null;
  const stageTrack = isDesktopHomeViewport() ? document.querySelector('[data-stages-track]') : null;
  if (stageSection && stagesPin && stagesScene && stageTrack) {
    const updateTrack = () => {
      const sectionRect = stageSection.getBoundingClientRect();
      const sectionTop = sectionRect.top + window.scrollY;
      const sectionBottom = sectionTop + stageSection.offsetHeight;
      const viewportHeight = window.innerHeight;
      const start = sectionTop;
      const end = sectionBottom - viewportHeight;
      const pinStart = start + 24;
      const y = window.scrollY;
      const progress = Math.min(Math.max((y - start) / Math.max(end - start, 1), 0), 1);
      const isActive = y >= pinStart && y <= end;
      const isComplete = y > end;

      stagesScene.classList.toggle('is-fixed', isActive);
      stagesScene.classList.toggle('is-complete', isComplete);
      if (isComplete) {
        stagesScene.style.transform = `translate3d(0, ${stagesPin.offsetHeight - viewportHeight}px, 0)`;
      } else {
        stagesScene.style.transform = '';
      }

      const startOffset = window.innerWidth;
      const endOffset = -Math.max(stageTrack.scrollWidth, 0);
      const currentOffset = startOffset + (endOffset - startOffset) * progress;
      stageTrack.style.transform = `translate3d(${currentOffset}px, 0, 0)`;
    };
    updateTrack();
    window.addEventListener('scroll', updateTrack, { passive: true });
    window.addEventListener('resize', updateTrack);
  }

  const forWhoSection = isDesktopHomeViewport() ? document.querySelector('#for-whom') : null;
  const forWhoPin = isDesktopHomeViewport() ? document.querySelector('.for-who-pin') : null;
  const forWhoScene = isDesktopHomeViewport() ? document.querySelector('[data-for-who-scene]') : null;
  const forWhoStage = isDesktopHomeViewport() ? document.querySelector('.for-who-stage') : null;
  const audienceCards = isDesktopHomeViewport() ? Array.from(document.querySelectorAll('[data-audience-card]')) : [];
  if (forWhoSection && forWhoPin && forWhoScene && forWhoStage && audienceCards.length) {
    const updateAudience = () => {
      const sectionRect = forWhoSection.getBoundingClientRect();
      const sectionTop = sectionRect.top + window.scrollY;
      const sectionBottom = sectionTop + forWhoSection.offsetHeight;
      const viewportHeight = window.innerHeight;
      const start = sectionTop;
      const end = sectionBottom - viewportHeight;
      const y = window.scrollY;
      const progress = Math.min(Math.max((y - start) / Math.max(end - start, 1), 0), 1);
      const isActive = y >= start && y <= end;
      const isComplete = y > end;

      forWhoScene.classList.toggle('is-fixed', isActive);
      forWhoScene.classList.toggle('is-complete', isComplete);
      forWhoScene.classList.toggle('is-active-flow', isActive || isComplete);
      forWhoScene.classList.toggle('is-final', progress >= 0.94);
      const finalState = forWhoScene.querySelector('.for-who-final');
      if (finalState) finalState.setAttribute('aria-hidden', progress >= 0.94 ? 'false' : 'true');
      if (isComplete) {
        forWhoScene.style.transform = `translate3d(0, ${forWhoSection.offsetHeight - viewportHeight}px, 0)`;
      } else {
        forWhoScene.style.transform = '';
      }

      const startOffset = viewportHeight;
      const travel = forWhoStage.offsetHeight + viewportHeight;
      const currentOffset = startOffset - travel * progress;
      forWhoStage.style.transform = `translate3d(0, ${currentOffset}px, 0)`;
    };
    updateAudience();
    window.addEventListener('scroll', updateAudience, { passive: true });
    window.addEventListener('resize', updateAudience);
  }
</script>
</body>
</html>
