<%- include('../partials/header', { title, description, siteName, siteDescription, transparentHeader: true, hideSiteHeader: true }) %>
<%
  const home = homeSettings || {};
  const bannerImage = home.HOME_BANNER_IMAGE || '';
  const bannerMobileImage = home.HOME_BANNER_MOBILE_IMAGE || '';
  const bannerLink = home.HOME_BANNER_LINK || '/entrepreneurs';
  const hasBannerImage = Boolean(bannerImage || bannerMobileImage);
  const projectLinks = typeof social !== 'undefined' ? social : {};
  const companiesSectionDefaults = ['hero', 'about', 'catalog', 'cta', 'banner'];
  let companiesSectionVisibility = {};
  let companiesSectionOrder = companiesSectionDefaults;
  try {
    const parsedVisibility = JSON.parse(home.COMPANIES_PAGE_SECTION_VISIBILITY || '{}');
    if (parsedVisibility && typeof parsedVisibility === 'object' && !Array.isArray(parsedVisibility)) companiesSectionVisibility = parsedVisibility;
  } catch {}
  try {
    const parsedOrder = JSON.parse(home.COMPANIES_PAGE_SECTION_ORDER || '[]');
    if (Array.isArray(parsedOrder)) {
      const valid = parsedOrder.filter((key, index) => companiesSectionDefaults.includes(key) && parsedOrder.indexOf(key) === index);
      companiesSectionOrder = [...valid, ...companiesSectionDefaults.filter((key) => !valid.includes(key))];
    }
  } catch {}
  const companiesSectionClass = (key) => companiesSectionVisibility[key] === false ? ' is-section-hidden' : '';
  const companiesHeroLines = (home.COMPANIES_PAGE_HERO_TITLE || 'ГЛАВНЫЕ\nКОМПАНИИ').split(/\r?\n/).filter(Boolean);
  const companiesAboutTitle = home.COMPANIES_PAGE_ABOUT_TITLE || 'О ПРОЕКТЕ';
  const companiesAboutText = home.COMPANIES_PAGE_ABOUT_TEXT || 'Мы рассказываем личные истории предпринимателей через их дело. За каждым рестораном, магазином, студией, производством или компанией стоит человек со своим путем, идеями, победами и трудностями. Именно эти истории мы показываем честно и без прикрас.\n\nНаши интервью, биографии, статьи и репортажи помогают увидеть не только успешный бизнес, но и людей, которые стоят за ним. Потому что главное не вывеска, а человек, который ее создал.';
%>

<div class="redesign-page companies-page">
  <section class="companies-hero<%= companiesSectionClass('hero') %>" id="top">
    <header class="home-header">
      <nav class="home-topbar companies-topbar">
        <div class="home-topbar__left">
          <a href="/" class="home-topbar__project-logo" data-header-project-logo aria-label="Кто здесь главный?">
            <img src="/images/image-29.svg" alt="Кто здесь главный?">
          </a>
          <a href="/entrepreneurs" class="home-topbar__link">ПРЕДПРИНИМАТЕЛИ</a>
          <a href="/companies" class="home-topbar__link">КОМПАНИИ</a>
          <a href="/blog" class="home-topbar__link">БЛОГ</a>
        </div>
        <div class="home-topbar__right">
          <a href="/shooting-request" class="home-topbar__shooting">СЪЕМКИ</a>
          <a href="/shooting-request" class="home-topbar__cta">СТАТЬ ГЕРОЕМ <span class="arrow-mark" aria-hidden="true"></span></a>
        </div>
      </nav>
    </header>

    <div class="companies-hero__copy">
      <h1>
        <span><%= companiesHeroLines[0] || 'ГЛАВНЫЕ' %></span>
        <span><%= companiesHeroLines.slice(1).join(' ') || 'КОМПАНИИ' %></span>
      </h1>
    </div>
  </section>

  <section class="companies-about<%= companiesSectionClass('about') %>" id="about">
    <div class="companies-container">
      <h2><%= companiesAboutTitle %></h2>
      <div class="companies-about__text">
        <% companiesAboutText.split(/\n\s*\n/).filter(Boolean).forEach((paragraph) => { %>
          <p><%= paragraph %></p>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="companies-catalog<%= companiesSectionClass('catalog') %>" id="companies">
    <div class="companies-container">
      <% if (businesses.length) { %>
        <div class="companies-grid">
          <% businesses.forEach((item) => { %>
            <a class="company-card" href="/companies/<%= item.slug %>">
              <div class="company-card__media">
                <h2 class="company-card__title"><%= item.name %></h2>
                <% if (item.coverImage) { %>
                  <img src="<%= item.coverImage %>" alt="<%= item.name %>">
                <% } %>
              </div>
              <div class="company-card__footer">
                <span class="company-card__arrow" aria-hidden="true">
                  <img src="/images/company-card-arrow.svg" alt="">
                </span>
                <p><%= item.type %></p>
              </div>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <p class="companies-empty">Компании скоро появятся.</p>
      <% } %>
    </div>
  </section>

  <%- include('../partials/shooting-cta', {
    sectionClass: companiesSectionClass('cta'),
    redirect: '/companies#shooting',
    formTitle: 'ЗАПОЛНИТЕ ВАШИ ДАННЫЕ\nДЛЯ СВЯЗИ',
    redHeaderTheme: false
  }) %>

  <section class="site-banner redesign-section<%= hasBannerImage ? ' site-banner--has-image' : '' %><%= companiesSectionClass('banner') %>">
    <a href="<%= bannerLink %>" class="site-banner-frame" aria-label="Открыть материал баннера">
      <% if (hasBannerImage) { %>
        <picture class="site-banner-media">
          <% if (bannerMobileImage) { %>
            <source media="(max-width: 768px)" srcset="<%= bannerMobileImage %>">
          <% } %>
          <img src="<%= bannerImage || bannerMobileImage %>" alt="" class="banner-image">
        </picture>
      <% } else { %>
        <div class="banner-title">ЗДЕСЬ БУДЕТ<br>БАНЕР О ТОМ<br>ЧТО ВЫШЛО<br>ИНТЕРВЬЮ<br>С НОВЫМ<br>ГЕРОЕМ</div>
      <% } %>
    </a>
  </section>
</div>
</main>

<footer class="redesign-footer" id="contacts">
  <div class="footer-top">
    <div class="footer-links footer-links--pages">
      <a href="/companies">КОМПАНИИ</a>
      <a href="/entrepreneurs">БИОГРАФИИ</a>
      <a href="/interviews">ИНТЕРВЬЮ</a>
      <a href="/blog">СТАТЬИ</a>
      <a href="/blog">БЛОГ</a>
    </div>
    <div class="footer-links footer-links--social">
      <%- include('../partials/social-text-links', { social: projectLinks }) %>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="footer-bottom-left">
      <div class="footer-cta-row">
        <span>ГОТОВЫ</span>
        <span>К</span>
        <span>ОБСУЖДЕНИЮ</span>
        <span>ПРОЕКТА</span>
        <span>?</span>
      </div>
      <div class="footer-action">
        <a class="footer-hero-button" href="/shooting-request">СТАТЬ ГЕРОЕМ <span class="arrow-mark" aria-hidden="true"></span></a>
      </div>
    </div>
    <div class="footer-meta">
      <span>ИП</span>
      <span>БАТАГОВ А.А.</span>
      <span>TILDA EXPERTS</span>
      <span>ПОЛИТИКА КОНФ-ТИ</span>
    </div>
  </div>
</footer>

<script src="/js/main.js" defer></script>
<script>
  (() => {
    const page = document.querySelector('.companies-page');
    if (!page) return;
    const selectors = {
      hero: '.companies-hero',
      about: '.companies-about',
      catalog: '.companies-catalog',
      cta: '.shooting-cta',
      banner: '.site-banner'
    };
    const order = <%- JSON.stringify(companiesSectionOrder) %>;
    order.forEach((key) => {
      const section = page.querySelector(selectors[key]);
      if (section) page.appendChild(section);
    });
  })();

  const companiesHomeHeader = document.querySelector('.home-header');
  const companiesHeroSection = document.querySelector('.companies-hero');
  const companiesHeaderProjectLogo = document.querySelector('[data-header-project-logo]');
  const companiesRedThemeSections = Array.from(document.querySelectorAll('.shooting-cta'));

  if (companiesHomeHeader && companiesRedThemeSections.length) {
    let companiesHeaderOnRed = false;

    const updateCompaniesHeaderTheme = () => {
      const probeY = companiesHomeHeader.getBoundingClientRect().bottom + 8;
      const overlapThreshold = 32;
      const activeRedSection = companiesRedThemeSections.some((section) => {
        const rect = section.getBoundingClientRect();
        return rect.top <= probeY - overlapThreshold && rect.bottom >= probeY + overlapThreshold;
      });

      if (activeRedSection !== companiesHeaderOnRed) {
        companiesHeaderOnRed = activeRedSection;
        companiesHomeHeader.classList.toggle('is-on-red', companiesHeaderOnRed);
      }
    };

    updateCompaniesHeaderTheme();
    window.addEventListener('scroll', updateCompaniesHeaderTheme, { passive: true });
    window.addEventListener('resize', updateCompaniesHeaderTheme);
  }

  if (companiesHeroSection && companiesHeaderProjectLogo) {
    const updateCompaniesProjectLogoVisibility = () => {
      const heroBottom = companiesHeroSection.getBoundingClientRect().bottom;
      const headerBottom = companiesHomeHeader ? companiesHomeHeader.getBoundingClientRect().bottom : 0;
      companiesHeaderProjectLogo.classList.toggle('is-docked', heroBottom <= headerBottom + 12);
    };

    updateCompaniesProjectLogoVisibility();
    window.addEventListener('scroll', updateCompaniesProjectLogoVisibility, { passive: true });
    window.addEventListener('resize', updateCompaniesProjectLogoVisibility);
  }
</script>
</body>
</html>
