<script src="/js/main.js" defer></script>
<script>
  const detailHomeHeader = document.querySelector('.home-header');
  const detailHeroSection = document.querySelector('.entrepreneur-profile-hero');
  const detailHeaderProjectLogo = document.querySelector('[data-header-project-logo]');
  const detailRedThemeSections = Array.from(document.querySelectorAll('[data-red-header-theme]'));

  if (detailHomeHeader && detailRedThemeSections.length) {
    let detailHeaderOnRed = false;

    const updateDetailHeaderTheme = () => {
      const probeY = detailHomeHeader.getBoundingClientRect().bottom + 8;
      const overlapThreshold = 32;
      const activeRedSection = detailRedThemeSections.some((section) => {
        const rect = section.getBoundingClientRect();
        return rect.top <= probeY - overlapThreshold && rect.bottom >= probeY + overlapThreshold;
      });

      if (activeRedSection !== detailHeaderOnRed) {
        detailHeaderOnRed = activeRedSection;
        detailHomeHeader.classList.toggle('is-on-red', detailHeaderOnRed);
      }
    };

    updateDetailHeaderTheme();
    window.addEventListener('scroll', updateDetailHeaderTheme, { passive: true });
    window.addEventListener('resize', updateDetailHeaderTheme);
  }

  if (detailHeroSection && detailHeaderProjectLogo) {
    const updateDetailProjectLogoVisibility = () => {
      const heroBottom = detailHeroSection.getBoundingClientRect().bottom;
      const headerBottom = detailHomeHeader ? detailHomeHeader.getBoundingClientRect().bottom : 0;
      detailHeaderProjectLogo.classList.toggle('is-docked', heroBottom <= headerBottom + 12);
    };

    updateDetailProjectLogoVisibility();
    window.addEventListener('scroll', updateDetailProjectLogoVisibility, { passive: true });
    window.addEventListener('resize', updateDetailProjectLogoVisibility);
  }

  const aboutNavLinks = Array.from(document.querySelectorAll('[data-about-nav-link]'));
  const aboutGallerySlides = Array.from(document.querySelectorAll('[data-about-gallery-slide]'));
  const aboutGalleryViewport = document.querySelector('[data-about-gallery-viewport]');
  const defaultAboutIndex = aboutNavLinks.length > 1 ? 1 : 0;
  const turnoverRight = document.querySelector('.entrepreneur-turnover__right');
  const turnoverPhoto = document.querySelector('.entrepreneur-turnover__photo');
  const turnoverBottomText = document.querySelector('.entrepreneur-turnover__bottom-text');
  const moreCardsWrap = document.querySelector('.entrepreneur-more__cards');
  const moreTopCard = document.querySelector('.entrepreneur-more__row--top .entrepreneur-more__card');
  const moreSide = document.querySelector('.entrepreneur-more__side');

  const setAboutGallerySlide = (nextIndex) => {
    if (!aboutGallerySlides.length) return;
    const safeIndex = ((nextIndex % aboutGallerySlides.length) + aboutGallerySlides.length) % aboutGallerySlides.length;
    aboutGallerySlides.forEach((slide, index) => {
      slide.classList.toggle('is-active', index === safeIndex);
    });
  };

  const setAboutActiveLink = (nextIndex) => {
    aboutNavLinks.forEach((link, index) => {
      link.classList.toggle('is-active', index === nextIndex);
    });
  };

  setAboutActiveLink(defaultAboutIndex);
  setAboutGallerySlide(defaultAboutIndex);

  aboutNavLinks.forEach((link) => {
    const photoIndex = Number(link.getAttribute('data-photo-index') || 0);
    const linkIndex = aboutNavLinks.indexOf(link);
    link.addEventListener('mouseenter', () => {
      setAboutActiveLink(linkIndex);
      setAboutGallerySlide(photoIndex);
    });
    link.addEventListener('focus', () => {
      setAboutActiveLink(linkIndex);
      setAboutGallerySlide(photoIndex);
    });
  });

  const aboutNavList = document.querySelector('.entrepreneur-about__nav-list');
  const syncAboutGalleryHeight = () => {
    if (!aboutNavList || !aboutGalleryViewport) return;
    const navHeight = Math.ceil(aboutNavList.getBoundingClientRect().height);
    aboutGalleryViewport.style.height = `${navHeight}px`;
    aboutGalleryViewport.style.minHeight = `${navHeight}px`;
  };

  const syncTurnoverBottomText = () => {
    if (!turnoverRight || !turnoverPhoto || !turnoverBottomText) return;
    const rightRect = turnoverRight.getBoundingClientRect();
    const photoRect = turnoverPhoto.getBoundingClientRect();
    const textRect = turnoverBottomText.getBoundingClientRect();
    const top = Math.max(0, photoRect.bottom - rightRect.top - textRect.height);
    turnoverRight.style.setProperty('--turnover-bottom-text-top', `${top}px`);
  };

  const syncMoreSquareSize = () => {
    if (!moreCardsWrap || !moreTopCard) return;
    const squareHeight = Math.round(moreTopCard.getBoundingClientRect().height);
    moreCardsWrap.style.setProperty('--entrepreneur-more-square-size', `${squareHeight}px`);
  };

  syncAboutGalleryHeight();
  syncTurnoverBottomText();
  syncMoreSquareSize();
  window.addEventListener('resize', syncAboutGalleryHeight);
  window.addEventListener('resize', syncTurnoverBottomText);
  window.addEventListener('resize', syncMoreSquareSize);

  if (aboutNavList) {
    aboutNavList.addEventListener('mouseleave', () => {
      setAboutActiveLink(defaultAboutIndex);
      setAboutGallerySlide(defaultAboutIndex);
    });
  }

  window.addEventListener('load', syncTurnoverBottomText);
  window.addEventListener('load', syncMoreSquareSize);

  const reelModal = document.querySelector('[data-reel-modal]');
  const reelModalMedia = document.querySelector('[data-reel-modal-media]');
  const reelModalClose = document.querySelector('[data-reel-close]');

  if (reelModal && reelModalMedia) {
    const renderReel = (dataset) => {
      const type = dataset.reelVideoType || '';
      const url = dataset.reelVideoUrl || '';
      const file = dataset.reelVideoFile || '';

      if (type === 'EMBED' && url) {
        reelModalMedia.innerHTML = `<iframe src="${url}" style="width:100%;height:100%;border:0;" allowfullscreen title="${dataset.reelTitle || 'Рилс'}"></iframe>`;
        return;
      }

      if (file) {
        reelModalMedia.innerHTML = `<video src="${file}" style="width:100%;height:100%;display:block;" controls autoplay playsinline preload="metadata"></video>`;
        return;
      }

      reelModalMedia.innerHTML = '';
    };

    const openReelModal = (dataset) => {
      renderReel(dataset);
      reelModal.hidden = false;
      reelModal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    };

    const closeReelModal = () => {
      reelModal.hidden = true;
      reelModal.style.display = 'none';
      reelModalMedia.innerHTML = '';
      document.body.style.overflow = '';
    };

    document.querySelectorAll('[data-reel-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', () => openReelModal(trigger.dataset));
    });

    reelModalClose?.addEventListener('click', closeReelModal);
    reelModal.addEventListener('click', (event) => {
      if (event.target === reelModal) closeReelModal();
    });
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !reelModal.hidden) closeReelModal();
    });
  }
</script>
<script>
  (() => {
    const page = document.querySelector('.entrepreneur-profile-page');
    if (!page) return;
    const selectors = {
      hero: '.entrepreneur-profile-hero',
      about: '.entrepreneur-about',
      biography: '.entrepreneur-biography',
      childhood: '.entrepreneur-childhood',
      education: '.entrepreneur-education',
      shorts: '.entrepreneur-shorts',
      turnover: '.entrepreneur-turnover',
      more: '.entrepreneur-more',
      featuredInterview: '.entrepreneur-featured-interview',
      cta: '.shooting-cta',
      banner: '.site-banner',
      interviewList: '#interview-list',
      articles: '#articles'
    };
    const order = <%- JSON.stringify(sectionOrder) %>;
    order.forEach((key) => {
      const section = page.querySelector(selectors[key]);
      if (section) page.appendChild(section);
    });
  })();
</script>
