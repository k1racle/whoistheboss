NODE_ENV=development
PORT=3000

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=guessboss
POSTGRES_PORT=5433
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Sessions
SESSION_SECRET=change-me-to-a-random-string-min-32-characters
NUXT_SESSION_PASSWORD=change-me-to-a-random-string-min-32-characters

# Seed
