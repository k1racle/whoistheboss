NODE_ENV=development
PORT=3000

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=guessboss
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public

# Sessions
SESSION_SECRET=change-me-to-a-random-string-min-32-characters
NUXT_SESSION_PASSWORD=change-me-to-a-random-string-min-32-characters

# Seed
ADMIN_SEED_PASSWORD=admin123

# File uploads
UPLOAD_DIR=./public/uploads
MAX_UPLOAD_SIZE_MB=100
MAX_IMAGE_UPLOAD_SIZE_MB=20

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
FROM_EMAIL=noreply@example.com
ADMIN_EMAIL=admin@example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Site
SITE_URL=http://localhost:3000
SITE_NAME=Кто здесь главный?
SITE_DESCRIPTION=Интервью с основателями бизнеса. Видео, рилсы, фото.
