NODE_ENV=development
PORT=3000

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=guessboss
POSTGRES_PORT=5433
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Sessions
SESSION_SECRET=change-me-to-a-random-string-min-32-characters
NUXT_SESSION_PASSWORD=change-me-to-a-random-string-min-32-characters

# Seed
ADMIN_SEED_PASSWORD=replace-with-a-unique-password-min-12-characters

# Existing external Docker network shared with Nginx Proxy Manager
PROXY_NETWORK=web

# File uploads
UPLOAD_DIR=./public/uploads
MAX_UPLOAD_SIZE_MB=100
MAX_IMAGE_UPLOAD_SIZE_MB=20
FIX_UPLOAD_PERMISSIONS=false

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
FROM_EMAIL=noreply@example.com
ADMIN_EMAIL=admin@example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Site
SITE_URL=https://xn----7sbqzieaghadljej2f.xn--p1ai
SITE_NAME=МАРШРУТ ПОСТРОЕН МЕДИАГИД
SITE_DESCRIPTION=Медиагид о предпринимателях, компаниях, брендах и проектах России.

# Optional IndexNow key. Leave empty to disable notifications.
INDEXNOW_KEY=
