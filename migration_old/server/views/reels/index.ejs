<%- include('../partials/header', { title, description, siteName, siteDescription }) %>

<section class="py-24 md:py-32 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-14 animate-on-scroll">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-4 section-title">Коротко. Рилсы</h1>
      <p class="text-xl text-gray-600 leading-relaxed">Быстрые истории и инсайты от предпринимателей.</p>
    </div>

    <% if (reels.length) { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <% reels.forEach((item, index) => { %>
      <article class="animate-on-scroll card overflow-hidden group" style="transition-delay: <%= index * 100 %>ms">
        <button
          type="button"
          class="group block relative aspect-reel bg-gray-900 overflow-hidden img-zoom w-full text-left"
          style="padding:0;border:0"
          data-reel-trigger
          data-reel-title="<%= item.title %>"
          data-reel-video-type="<%= item.videoType %>"
          data-reel-video-url="<%= item.videoUrl || '' %>"
          data-reel-video-file="<%= item.videoFile || '' %>"
        >
          <img src="<%= item.coverImage || item.entrepreneur?.photo || '/images/placeholder.svg' %>" alt="<%= item.entrepreneur?.name || item.title %>" class="w-full h-full object-cover opacity-90 group-hover:scale-105 transition-transform duration-500 blur-[2px]">
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-16 h-16 rounded-full bg-white/95 flex items-center justify-center group-hover:bg-terracotta group-hover:text-white transition-all duration-300 group-hover:scale-110 shadow-lg">
              <svg class="w-7 h-7 ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
        </button>
        <div class="p-6">
          <h2 class="font-bold text-lg group-hover:text-terracotta transition-colors"><button type="button" class="text-left" style="padding:0;border:0;background:none" data-reel-trigger data-reel-title="<%= item.title %>" data-reel-video-type="<%= item.videoType %>" data-reel-video-url="<%= item.videoUrl || '' %>" data-reel-video-file="<%= item.videoFile || '' %>"><%= item.title %></button></h2>
        </div>
      </article>
      <% }) %>
    </div>
    <% } else { %>
    <p class="text-gray-500 animate-on-scroll">Пока нет опубликованных рилсов.</p>
    <% } %>
  </div>
</section>

<div data-reel-modal hidden style="position:fixed;inset:0;z-index:100;background:rgba(7,7,7,.72);padding:24px;align-items:center;justify-content:center;">
  <div style="position:relative;width:min(100%,420px);max-height:100%;">
    <button type="button" data-reel-close style="position:absolute;top:-44px;right:0;padding:0;border:0;background:none;color:#fff;font:400 16px/16px 'DexaPro',sans-serif;text-transform:uppercase;cursor:pointer;">Закрыть</button>
    <div style="background:#111;aspect-ratio:9/16;overflow:hidden;">
      <div data-reel-modal-media style="width:100%;height:100%;"></div>
    </div>
  </div>
</div>

<% if (activeReel) { %>
  <div
    data-reel-active
    hidden
    data-reel-title="<%= activeReel.title %>"
    data-reel-video-type="<%= activeReel.videoType %>"
    data-reel-video-url="<%= activeReel.videoUrl || '' %>"
    data-reel-video-file="<%= activeReel.videoFile || '' %>"
  ></div>
<% } %>

<script>
  (() => {
    const modal = document.querySelector('[data-reel-modal]');
    const media = document.querySelector('[data-reel-modal-media]');
    const closeButton = document.querySelector('[data-reel-close]');
    const activePreset = document.querySelector('[data-reel-active]');

    if (!modal || !media) return;

    const renderReel = (dataset) => {
      const type = dataset.reelVideoType || '';
      const url = dataset.reelVideoUrl || '';
      const file = dataset.reelVideoFile || '';

      if (type === 'EMBED' && url) {
        media.innerHTML = `<iframe src="${url}" style="width:100%;height:100%;border:0;" allowfullscreen title="${dataset.reelTitle || 'Рилс'}"></iframe>`;
        return;
      }

      if (file) {
        media.innerHTML = `<video src="${file}" style="width:100%;height:100%;display:block;" controls autoplay playsinline preload="metadata"></video>`;
        return;
      }

      media.innerHTML = '';
    };

    const openModal = (dataset) => {
      renderReel(dataset);
      modal.hidden = false;
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    };

    const closeModal = () => {
      modal.hidden = true;
      modal.style.display = 'none';
      media.innerHTML = '';
      document.body.style.overflow = '';
    };

    document.querySelectorAll('[data-reel-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', () => openModal(trigger.dataset));
    });

    closeButton?.addEventListener('click', closeModal);
    modal.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.hidden) closeModal();
    });

    if (activePreset) {
      openModal(activePreset.dataset);
    }
  })();
</script>

<%- include('../partials/footer', { siteName, siteDescription }) %>
